{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(npx -c \"node --print process.env.PATH\")"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "bump": {
      "name": "bump",
      "description": "Bumps version based on latest git tag and generates a changelog entry",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "VERSIONRCOPTIONS": "{\"types\":[{\"type\":\"feat\",\"section\":\"Features\"},{\"type\":\"fix\",\"section\":\"Bug Fixes\"},{\"type\":\"chore\",\"section\":\"Chores\"},{\"type\":\"docs\",\"section\":\"Docs\"},{\"type\":\"style\",\"hidden\":true},{\"type\":\"refactor\",\"hidden\":true},{\"type\":\"perf\",\"section\":\"Performance\"},{\"type\":\"test\",\"hidden\":true}]}",
        "BUMP_PACKAGE": "commit-and-tag-version@^12"
      },
      "steps": [
        {
          "builtin": "release/resolve-latest-tag",
          "outputEnv": "LATEST_TAG"
        },
        {
          "spawn": "bump:releasable-commits",
          "outputEnv": "RELEASABLE_COMMITS",
          "condition": "git rev-parse --verify --quiet \"refs/tags/$LATEST_TAG\""
        },
        {
          "builtin": "release/suggest-version-bump",
          "outputEnv": "SUGGESTED_BUMP"
        },
        {
          "builtin": "release/apply-version-bump"
        }
      ],
      "condition": "git log --oneline -1 | grep -v \"chore(release):\" > /dev/null"
    },
    "bump:releasable-commits": {
      "name": "bump:releasable-commits",
      "description": "Print the releasable commits since the latest release",
      "steps": [
        {
          "exec": "git log --no-merges --oneline $LATEST_TAG..HEAD -E --grep '^(feat|fix|chore|refactor|perf){1}(\\([^()[:space:]]+\\))?(!)?:[[:blank:]]+.+'"
        }
      ]
    },
    "bundle": {
      "name": "bundle",
      "description": "Prepare assets",
      "steps": [
        {
          "spawn": "bundle:idle-monitor/idle-monitor.lambda"
        },
        {
          "spawn": "bundle:idle-monitor-enabler/idle-monitor-enabler.lambda"
        },
        {
          "spawn": "bundle:installer/installer.lambda"
        },
        {
          "spawn": "bundle:secret-retriever/secret-retriever.lambda"
        }
      ]
    },
    "bundle:idle-monitor-enabler/idle-monitor-enabler.lambda": {
      "name": "bundle:idle-monitor-enabler/idle-monitor-enabler.lambda",
      "description": "Create a JavaScript bundle from src/idle-monitor-enabler/idle-monitor-enabler.lambda.ts",
      "steps": [
        {
          "exec": "esbuild --bundle src/idle-monitor-enabler/idle-monitor-enabler.lambda.ts --target=\"node24\" --platform=\"node\" --outfile=\"assets/idle-monitor-enabler/idle-monitor-enabler.lambda/index.js\" --tsconfig=\"test/tsconfig.json\" --external:@aws-sdk/*"
        }
      ]
    },
    "bundle:idle-monitor-enabler/idle-monitor-enabler.lambda:watch": {
      "name": "bundle:idle-monitor-enabler/idle-monitor-enabler.lambda:watch",
      "description": "Continuously update the JavaScript bundle from src/idle-monitor-enabler/idle-monitor-enabler.lambda.ts",
      "steps": [
        {
          "exec": "esbuild --bundle src/idle-monitor-enabler/idle-monitor-enabler.lambda.ts --target=\"node24\" --platform=\"node\" --outfile=\"assets/idle-monitor-enabler/idle-monitor-enabler.lambda/index.js\" --tsconfig=\"test/tsconfig.json\" --external:@aws-sdk/* --watch"
        }
      ]
    },
    "bundle:idle-monitor/idle-monitor.lambda": {
      "name": "bundle:idle-monitor/idle-monitor.lambda",
      "description": "Create a JavaScript bundle from src/idle-monitor/idle-monitor.lambda.ts",
      "steps": [
        {
          "exec": "esbuild --bundle src/idle-monitor/idle-monitor.lambda.ts --target=\"node24\" --platform=\"node\" --outfile=\"assets/idle-monitor/idle-monitor.lambda/index.js\" --tsconfig=\"test/tsconfig.json\" --external:@aws-sdk/*"
        }
      ]
    },
    "bundle:idle-monitor/idle-monitor.lambda:watch": {
      "name": "bundle:idle-monitor/idle-monitor.lambda:watch",
      "description": "Continuously update the JavaScript bundle from src/idle-monitor/idle-monitor.lambda.ts",
      "steps": [
        {
          "exec": "esbuild --bundle src/idle-monitor/idle-monitor.lambda.ts --target=\"node24\" --platform=\"node\" --outfile=\"assets/idle-monitor/idle-monitor.lambda/index.js\" --tsconfig=\"test/tsconfig.json\" --external:@aws-sdk/* --watch"
        }
      ]
    },
    "bundle:installer/installer.lambda": {
      "name": "bundle:installer/installer.lambda",
      "description": "Create a JavaScript bundle from src/installer/installer.lambda.ts",
      "steps": [
        {
          "exec": "esbuild --bundle src/installer/installer.lambda.ts --target=\"node24\" --platform=\"node\" --outfile=\"assets/installer/installer.lambda/index.js\" --tsconfig=\"test/tsconfig.json\" --external:@aws-sdk/*"
        }
      ]
    },
    "bundle:installer/installer.lambda:watch": {
      "name": "bundle:installer/installer.lambda:watch",
      "description": "Continuously update the JavaScript bundle from src/installer/installer.lambda.ts",
      "steps": [
        {
          "exec": "esbuild --bundle src/installer/installer.lambda.ts --target=\"node24\" --platform=\"node\" --outfile=\"assets/installer/installer.lambda/index.js\" --tsconfig=\"test/tsconfig.json\" --external:@aws-sdk/* --watch"
        }
      ]
    },
    "bundle:secret-retriever/secret-retriever.lambda": {
      "name": "bundle:secret-retriever/secret-retriever.lambda",
      "description": "Create a JavaScript bundle from src/secret-retriever/secret-retriever.lambda.ts",
      "steps": [
        {
          "exec": "esbuild --bundle src/secret-retriever/secret-retriever.lambda.ts --target=\"node24\" --platform=\"node\" --outfile=\"assets/secret-retriever/secret-retriever.lambda/index.js\" --tsconfig=\"test/tsconfig.json\" --external:@aws-sdk/*"
        }
      ]
    },
    "bundle:secret-retriever/secret-retriever.lambda:watch": {
      "name": "bundle:secret-retriever/secret-retriever.lambda:watch",
      "description": "Continuously update the JavaScript bundle from src/secret-retriever/secret-retriever.lambda.ts",
      "steps": [
        {
          "exec": "esbuild --bundle src/secret-retriever/secret-retriever.lambda.ts --target=\"node24\" --platform=\"node\" --outfile=\"assets/secret-retriever/secret-retriever.lambda/index.js\" --tsconfig=\"test/tsconfig.json\" --external:@aws-sdk/* --watch"
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)"
      },
      "steps": [
        {
          "exec": "git checkout -b scratch",
          "name": "save current HEAD in \"scratch\" branch"
        },
        {
          "exec": "git checkout $BRANCH"
        },
        {
          "exec": "git fetch origin",
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard origin/$BRANCH",
          "name": "hard reset to origin commit"
        },
        {
          "exec": "git clean -fdx",
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under the \"scratch\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compat": {
      "name": "compat",
      "description": "Perform API compatibility check against latest version",
      "steps": [
        {
          "exec": "jsii-diff npm:$(node -p \"require('./package.json').name\") -k --ignore-file .compatignore || (echo \"\nUNEXPECTED BREAKING CHANGES: add keys such as 'removed:constructs.Node.of' to .compatignore to skip.\n\" && exit 1)"
        }
      ]
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "exec": "jsii --silence-warnings=reserved-word"
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "execArgs": [
            "ts-node",
            "--project",
            "projenrc/tsconfig.json",
            ".projenrc.ts"
          ]
        }
      ]
    },
    "docgen": {
      "name": "docgen",
      "description": "Generate API.md from .jsii manifest",
      "steps": [
        {
          "execArgs": [
            "jsii-docgen",
            "-o",
            "API.md"
          ]
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "eslint": {
      "name": "eslint",
      "description": "Runs eslint against the codebase",
      "env": {
        "ESLINT_USE_FLAT_CONFIG": "false",
        "NODE_NO_WARNINGS": "1"
      },
      "steps": [
        {
          "exec": "eslint --ext .ts,.tsx --fix --no-error-on-unmatched-pattern $@ src test build-tools projenrc .projenrc.ts",
          "receiveArgs": true
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "npm install"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "npm ci"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package",
      "steps": [
        {
          "spawn": "package:js",
          "condition": "node -e \"if (!process.env.CI) process.exit(1)\""
        },
        {
          "spawn": "package-all",
          "condition": "node -e \"if (process.env.CI) process.exit(1)\""
        }
      ]
    },
    "package-all": {
      "name": "package-all",
      "description": "Packages artifacts for all target languages",
      "steps": [
        {
          "spawn": "package:js"
        },
        {
          "spawn": "package:python"
        }
      ]
    },
    "package:js": {
      "name": "package:js",
      "description": "Create js language bindings",
      "steps": [
        {
          "execArgs": [
            "jsii-pacmak",
            "-v",
            "--target",
            "js"
          ]
        }
      ]
    },
    "package:python": {
      "name": "package:python",
      "description": "Create python language bindings",
      "steps": [
        {
          "execArgs": [
            "jsii-pacmak",
            "-v",
            "--target",
            "python"
          ]
        }
      ]
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation",
      "steps": [
        {
          "spawn": "docgen"
        }
      ]
    },
    "post-upgrade": {
      "name": "post-upgrade",
      "description": "Runs after upgrading dependencies"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation",
      "steps": [
        {
          "spawn": "bundle"
        }
      ]
    },
    "release": {
      "name": "release",
      "description": "Prepare a release from \"main\" branch",
      "env": {
        "RELEASE": "true"
      },
      "steps": [
        {
          "exec": "rm -fr dist"
        },
        {
          "spawn": "bump"
        },
        {
          "spawn": "build"
        },
        {
          "spawn": "unbump"
        },
        {
          "exec": "git diff --ignore-space-at-eol --exit-code"
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "exec": "jest --passWithNoTests --updateSnapshot",
          "receiveArgs": true
        },
        {
          "spawn": "eslint"
        }
      ]
    },
    "test:watch": {
      "name": "test:watch",
      "description": "Run jest in watch mode",
      "steps": [
        {
          "exec": "jest --watch"
        }
      ]
    },
    "unbump": {
      "name": "unbump",
      "description": "Restores version to 0.0.0",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "VERSIONRCOPTIONS": "{\"types\":[{\"type\":\"feat\",\"section\":\"Features\"},{\"type\":\"fix\",\"section\":\"Bug Fixes\"},{\"type\":\"chore\",\"section\":\"Chores\"},{\"type\":\"docs\",\"section\":\"Docs\"},{\"type\":\"style\",\"hidden\":true},{\"type\":\"refactor\",\"hidden\":true},{\"type\":\"perf\",\"section\":\"Performance\"},{\"type\":\"test\",\"hidden\":true}]}",
        "BUMP_PACKAGE": "commit-and-tag-version@^12"
      },
      "steps": [
        {
          "builtin": "release/reset-version"
        }
      ]
    },
    "upgrade": {
      "name": "upgrade",
      "description": "upgrade dependencies",
      "env": {
        "CI": "0"
      },
      "steps": [
        {
          "execArgs": [
            "npx",
            "npm-check-updates@20",
            "--upgrade",
            "--target=minor",
            "--peer",
            "--no-deprecated",
            "--dep=dev,prod,peer,optional",
            "--filter=@aws-sdk/client-cloudwatch,@aws-sdk/client-dynamodb,@aws-sdk/client-ec2,@aws-sdk/client-eventbridge,@aws-sdk/client-secrets-manager,@aws-sdk/client-ssm,@aws-sdk/lib-dynamodb,@types/aws-lambda,@types/jest,@types/jsdom,esbuild,eslint-import-resolver-typescript,eslint-plugin-import,jest,jsii-diff,jsii-pacmak,ts-jest,ts-node,node-html-parser"
          ]
        },
        {
          "exec": "npm install"
        },
        {
          "execArgs": [
            "npm",
            "update",
            "@aws-cdk/integ-runner",
            "@aws-cdk/integ-tests-alpha",
            "@aws-sdk/client-cloudwatch",
            "@aws-sdk/client-dynamodb",
            "@aws-sdk/client-ec2",
            "@aws-sdk/client-eventbridge",
            "@aws-sdk/client-secrets-manager",
            "@aws-sdk/client-ssm",
            "@aws-sdk/lib-dynamodb",
            "@commitlint/cli",
            "@commitlint/config-conventional",
            "@stylistic/eslint-plugin",
            "@types/aws-lambda",
            "@types/jest",
            "@types/jsdom",
            "@types/node",
            "@typescript-eslint/eslint-plugin",
            "@typescript-eslint/parser",
            "awslint",
            "commit-and-tag-version",
            "esbuild",
            "eslint-import-resolver-typescript",
            "eslint-plugin-import",
            "eslint",
            "husky",
            "jest",
            "jest-junit",
            "jsii-diff",
            "jsii-docgen",
            "jsii-pacmak",
            "jsii-rosetta",
            "jsii",
            "ts-jest",
            "ts-node",
            "typescript",
            "node-html-parser",
            "aws-cdk-lib",
            "constructs",
            "@mavogel/mvc-projen",
            "cdk-nag"
          ]
        },
        {
          "exec": "npx projen"
        },
        {
          "spawn": "post-upgrade"
        }
      ]
    },
    "watch": {
      "name": "watch",
      "description": "Watch & compile in the background",
      "steps": [
        {
          "exec": "jsii -w --silence-warnings=reserved-word"
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"npx projen\"."
}
